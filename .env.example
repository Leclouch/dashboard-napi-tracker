# Copy to .env.local. NEXT_PUBLIC_ values are baked into the browser bundle at build time,
# so set them before `npm run build`.

# Backend base URL as the browser reaches it (no trailing slash). The backend must list this
# dashboard's address (e.g. http://localhost:3001) in its CORS_ORIGINS. In production both must be
# on one domain (app.<domain> and api.<domain>): the login cookie is SameSite=Strict, so the
# browser won't send it from an unrelated site.
NEXT_PUBLIC_API_URL=http://localhost:3000
